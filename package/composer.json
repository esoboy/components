{
    "name": "esoboy/ui",
    "description": "shadcn/ui style component library for Laravel and Livewire.",
    "keywords": ["laravel", "livewire", "blade", "components", "ui", "shadcn"],
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0",
        "illuminate/view": "^13.0",
        "livewire/livewire": "^4.4",
        "livewire/blaze": "^1.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Esoboy\\Ui\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Esoboy\\Ui\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Esoboy\\Ui\\UiServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
